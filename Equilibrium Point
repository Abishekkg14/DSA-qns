class Solution {
    public static int findEquilibrium(int arr[]) {
        
        int n = arr.length;
        
        int leftsum = 0;
        int total = 0;
        
        for(int x: arr){
            total+=x;
        }
        
        for(int i=0; i<n; i++){
            int right_sum = total - arr[i] - leftsum;
            
            if(leftsum == right_sum){
                return i;
            }
            
            leftsum+= arr[i];
        }
        
        return -1;
        
    }
}
